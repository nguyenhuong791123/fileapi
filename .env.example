# File API settings (copy to .env). The SFTP account is configured here only.

# Access tokens of the token server (same as be: JWT_JWKS_URI / JWT_PUBLIC_KEY / JWT_SECRET)
JWT_JWKS_URI=http://localhost:8089/oauth2/jwks
JWT_ALGORITHMS=RS256
# JWT_ISSUER=
# JWT_AUDIENCE=
# false only for local tests without the token server
AUTH_REQUIRED=true

# Browser origins allowed to call the API (comma separated)
CORS_ORIGINS=http://localhost:1234
# Entries may be regular expressions, e.g. http://[a-z0-9-]+\.localhost:1234
# Entries may be regular expressions, e.g. http://[a-z0-9-]+\.localhost:1234

# SFTP server (password or private key)
SFTP_HOST=sftp.example.com
SFTP_PORT=22
SFTP_USER=
SFTP_PASSWORD=
# SFTP_PRIVATE_KEY_FILE=/run/secrets/sftp_key
# SFTP_PRIVATE_KEY_PASSPHRASE=
# Uploads go below this directory; downloads are limited to it (empty = login directory)
SFTP_BASE_DIR=upload
# known_hosts file with the server's host key; SFTP_STRICT_HOST_KEY=false accepts any key (local only)
SFTP_KNOWN_HOSTS=
SFTP_STRICT_HOST_KEY=true
SFTP_TIMEOUT=15

# Limits
FILE_MAX_FILES=50
FILE_MAX_DOWNLOAD_MB=100
MAX_CONTENT_MB=100

# SFTP account of each company from the API server (サーバー情報 > ファイルサーバー of the tenant DB):
# be /internal/file-servers/<tenant>. When set, SFTP_HOST / SFTP_PORT / SFTP_USER / SFTP_PASSWORD /
# SFTP_PRIVATE_KEY_* are not used (SFTP_BASE_DIR, SFTP_KNOWN_HOSTS, SFTP_STRICT_HOST_KEY, SFTP_TIMEOUT still are).
# INTERNAL_API_SECRET: same value as be INTERNAL_API_SECRET (16+ characters)
SERVER_SETTINGS_URI=
INTERNAL_API_SECRET=
# Seconds the account of a company is cached
SERVER_SETTINGS_TTL=60
